# MongoDB — native client (TEAM db for team auth / Expo tokens)
ANALYTICS_MONGO_URL=mongodb://localhost:27017/analytics
ANALYTICS_DB_NAME=referral
ANALYTICS_SCHEDULED_NOTIFICATION_COLLECTION=scheduled_notifications

# MongoDB — mongoose (same as Karigar_server-new- MONGO_URL; orders, users, merchants; workers are read from karigarDB.labors)
MONGO_URL=mongodb://localhost:27017/karigarDB
# MONGODB_URI=mongodb://localhost:27017/karigarDB

# JWT (team login)
JWT_SECRET=your-jwt-secret
SECTRT_KEY=your-access-token-secret
REFRESH_KEY=your-refresh-token-secret

# MSG91 OTP (team /auth)
MSG91_AUTH_KEY=
SENDER_ID=
TEMPLATE_ID=

# MSG91 — team WhatsApp bulk (TEAM_MEMBERS_NUMBERS) + new order SMS
MSG91_WHATSAPP_INTEGRATED_NUMBER=
TEAM_MEMBERS_NUMBERS=919876543210,919876543211
NEW_ORDER_TEMPLATE_ID=


# Scheduler watcher
SCHEDULE_WATCH_INTERVAL_MS=15000

PORT=3000
